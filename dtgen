#!/usr/bin/env python3
"""Wrapper for draw-things-cli generate: parameters live in TOML files, prompt and output path come from the command line"""

import argparse
import json
import random
import re
import shlex
import struct
import subprocess
import sys
import time
import tomllib
import urllib.request
import zlib
from pathlib import Path

# Resolve to the tool's real directory even when run through a symlink
TOOL_DIR = Path(__file__).resolve().parent
PARAMETERS_DIR = TOOL_DIR / "parameters"
PROMPTS_DIR = TOOL_DIR / "prompts"
ENHANCERS_DIR = TOOL_DIR / "enhancers"
T2S_MAP_PATH = TOOL_DIR / "data" / "t2s.txt"

KNOWN_TOP_KEYS = {
    "model", "prompt", "negative_prompt", "prompt_prefix", "prompt_suffix",
    "output_ext", "steps", "cfg", "width", "height", "frames", "strength",
    "seed", "embed_metadata", "backend", "options", "config", "enhancer",
}
DEFAULT_ENHANCER = {"url": "http://localhost:11434", "model": "qwen3.5:4b",
                    "language": "en"}
DEFAULT_ENHANCE_PRESET = "z-image"
# Chinese deliberately means Simplified: Chinese-capable image models are
# trained mostly on Simplified corpora, so it prompts better
LANGUAGE_DIRECTIVES = {
    "en": "Regardless of the input language, write the final prompt in English.",
    "zh": "Regardless of the input language, the final prompt MUST be written "
          "entirely in Simplified Chinese (简体中文); convert any Traditional "
          "Chinese characters to their Simplified forms.",
}
FIXED_LANGUAGE_PRAGMA = "# dtgen:fixed-language"
CUSTOM_ENHANCE_RULE = """You are a professional prompt editor for image and video generation models.

Your task:
1. Produce exactly one final prompt from the original prompt and the custom instruction.
2. When the instruction asks for a local change (e.g. "add a hat to the character"), merge that change into the original prompt and keep everything else intact; never produce multiple versions.
3. The output must be a complete prompt that can directly replace the original.

Do not output the original prompt, headings such as "Enhanced Prompt", explanations, comparisons, lists, Markdown, code blocks, or quotes wrapping the result."""
ENHANCE_MARKERS = (
    "Enhanced Prompt", "Modified Prompt", "Final Prompt",
    "Rewritten Prompt", "Optimized Prompt", "Updated Prompt",
)
SAMPLING_FLAGS = {
    "steps": "--steps",
    "cfg": "--cfg",
    "width": "--width",
    "height": "--height",
    "frames": "--frames",
    "strength": "--strength",
}
BACKEND_STRING_FLAGS = {
    "remote_url": "--remote-url",
    "remote_port": "--remote-port",
    "remote_shared_secret": "--remote-shared-secret",
    "api_key": "--api-key",
    "cloud_api_base_url": "--cloud-api-base-url",
    "models_dir": "--models-dir",
}
# Display names for the SamplerType / SeedMode enums, as written by the
# Draw Things UI into its XMP metadata (matched for compatibility)
SAMPLER_NAMES = {
    0: "DPM++ 2M Karras", 1: "Euler A", 2: "DDIM", 3: "PLMS",
    4: "DPM++ SDE Karras", 5: "UniPC", 6: "LCM", 7: "Euler A Substep",
    8: "DPM++ SDE Substep", 9: "TCD", 10: "Euler A Trailing",
    11: "DPM++ SDE Trailing", 12: "DPM++ 2M AYS", 13: "Euler A AYS",
    14: "DPM++ SDE AYS", 15: "DPM++ 2M Trailing", 16: "DDIM Trailing",
    17: "UniPC Trailing", 18: "UniPC AYS", 19: "TCD Trailing",
}
SEED_MODE_NAMES = {
    0: "Legacy", 1: "Torch CPU Compatible", 2: "Scale Alike",
    3: "NVIDIA GPU Compatible",
}
PNG_SIGNATURE = b"\x89PNG\r\n\x1a\n"
XMP_TEMPLATE = """<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="XMP Core 6.0.0">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/"
            xmlns:xmp="http://ns.adobe.com/xap/1.0/"
            xmlns:exif="http://ns.adobe.com/exif/1.0/">
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">{description}</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmp:CreatorTool>Draw Things</xmp:CreatorTool>
         <exif:UserComment>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">{user_comment}</rdf:li>
            </rdf:Alt>
         </exif:UserComment>
      </rdf:Description>
   </rdf:RDF>
</x:xmpmeta>"""


def die(message):
    print(f"dtgen: {message}", file=sys.stderr)
    sys.exit(1)


def resolve_named_path(value, base_dir, default_ext):
    """Values starting with "/", "~", "./" or "../" are treated as plain paths;
    anything else (subdirectories allowed) is resolved under base_dir,
    appending the default extension when the last segment has none"""
    path = Path(value).expanduser()
    if path.is_absolute() or value.startswith(("./", "../")):
        return path
    if not path.suffix:
        path = path.with_suffix(default_ext)
    return base_dir / path


def is_comment_line(line):
    stripped = line.lstrip()
    return (stripped in ("#", "//")
            or stripped.startswith("# ")
            or stripped.startswith("// "))


def read_text_file(path, what):
    if not path.is_file():
        die(f"{what} not found: {path}")
    lines = path.read_text(encoding="utf-8").splitlines()
    return "\n".join(l for l in lines if not is_comment_line(l)).strip()


def load_parameters(value):
    path = resolve_named_path(value, PARAMETERS_DIR, ".toml")
    if not path.is_file():
        die(f"parameter file not found: {path}")
    try:
        with path.open("rb") as f:
            params = tomllib.load(f)
    except tomllib.TOMLDecodeError as e:
        die(f"failed to parse parameter file ({path}): {e}")
    for key in params:
        if key not in KNOWN_TOP_KEYS:
            print(f'dtgen: warning: unknown key "{key}" in parameter file, ignored',
                  file=sys.stderr)
    return params


def resolve_prompt_text(args, params):
    if args.prompt is not None:
        return args.prompt
    if args.prompt_file is not None:
        path = resolve_named_path(args.prompt_file, PROMPTS_DIR, ".txt")
        return read_text_file(path, "prompt file")
    if "prompt" in params:
        return params["prompt"]
    if (PROMPTS_DIR / "default.txt").is_file():
        return read_text_file(PROMPTS_DIR / "default.txt", "prompt file")
    die("no prompt given: pass --prompt or --prompt-file, "
        "set prompt in the parameter file, or create prompts/default.txt")


def apply_prompt_affixes(text, params):
    parts = [params.get("prompt_prefix"), text, params.get("prompt_suffix")]
    return ", ".join(p for p in parts if p)


def load_enhancer_rule(name):
    path = resolve_named_path(name, ENHANCERS_DIR, ".txt")
    if not path.is_file():
        die(f"enhancer preset not found: {path}")
    text = path.read_text(encoding="utf-8").strip()
    first, _, rest = text.partition("\n")
    if first.strip() == FIXED_LANGUAGE_PRAGMA:
        return rest.strip(), True
    return text, False


_t2s_table = None


def to_simplified(text):
    """Deterministic char-level Traditional-to-Simplified conversion:
    the LLM ignores the zh directive when the input is long Traditional
    Chinese, and model-side conversion can silently rewrite wording"""
    global _t2s_table
    if _t2s_table is None:
        if not T2S_MAP_PATH.is_file():
            die(f"t2s character map not found: {T2S_MAP_PATH}")
        lines = [l for l in T2S_MAP_PATH.read_text(encoding="utf-8").splitlines()
                 if l and not l.startswith("#")]
        _t2s_table = str.maketrans(lines[0], lines[1])
    return text.translate(_t2s_table)


def call_ollama(cfg, system, prompt):
    payload = json.dumps({
        "model": cfg["model"],
        "messages": [{"role": "system", "content": system},
                     {"role": "user", "content": prompt}],
        "stream": False,
        "think": False,
    }).encode("utf-8")
    request = urllib.request.Request(
        cfg["url"].rstrip("/") + "/api/chat", data=payload,
        headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=300) as response:
            reply = json.load(response)
    except (OSError, ValueError) as e:
        print(f"dtgen: ollama request failed: {e}", file=sys.stderr)
        return None
    return (reply.get("message") or {}).get("content", "")


def clean_enhanced(text, strip_markers):
    text = text.strip()
    fenced = re.search(r"```[^\n]*\n(.*?)```", text, re.DOTALL)
    if fenced:
        text = fenced.group(1).strip()
    if strip_markers:
        best, best_len = -1, 0
        for marker in ENHANCE_MARKERS:
            index = text.rfind(marker)
            if index > best:
                best, best_len = index, len(marker)
        if best != -1:
            text = text[best + best_len:].strip()
            text = re.sub(r"^[^\n]*[:：]\s*", "", text).strip()
            text = re.sub(r"^[\s*#-]+", "", text).strip()
    while len(text) >= 2 and text[0] == text[-1] and text[0] in "\"'":
        text = text[1:-1].strip()
    return text


def enhance_prompt(text, args, params):
    cfg = {**DEFAULT_ENHANCER, **params.get("enhancer", {})}
    custom_mode = args.enhance is None
    if custom_mode:
        rule, fixed_language = CUSTOM_ENHANCE_RULE, False
    else:
        rule, fixed_language = load_enhancer_rule(args.enhance)
    language = args.enhance_language or cfg["language"]
    if language not in LANGUAGE_DIRECTIVES:
        die(f'unknown enhancement language "{language}" '
            f"(known: {', '.join(sorted(LANGUAGE_DIRECTIVES))})")
    instruction = args.enhance_instruction
    interactive = (not args.enhance_only and not args.enhance_once
                   and sys.stdin.isatty())
    current = text
    while True:
        # The language directive must lead the system instruction: appended
        # after a long rule it loses to the model's input-script copying
        # (measured with qwen3.5:4b on Traditional Chinese input)
        system = "" if fixed_language else LANGUAGE_DIRECTIVES[language] + "\n\n"
        system += rule
        if instruction:
            system += ("\n\nCustom instruction (takes precedence over the rules "
                       f"above): {instruction}")
        source = ("custom instruction" if custom_mode
                  else f"preset {args.enhance}")
        print(f"dtgen: enhancing prompt (model {cfg['model']}, {source})...",
              file=sys.stderr)
        result = call_ollama(cfg, system, current)
        if result is not None:
            result = clean_enhanced(result, custom_mode)
        if result:
            if language == "zh" and not fixed_language:
                result = to_simplified(result)
            current = result
        elif not interactive:
            die("prompt enhancement failed")
        else:
            print("dtgen: enhancement failed, prompt unchanged", file=sys.stderr)
        if not args.enhance_only:
            print("----- enhanced prompt -----", file=sys.stderr)
            print(current, file=sys.stderr)
            print("---------------------------", file=sys.stderr)
        if not interactive:
            return current
        while True:
            try:
                choice = input("dtgen: [g]enerate  [e]nhance again  "
                               "[i]nstruction  [q]uit > ").strip().lower()
            except EOFError:
                sys.exit(0)
            if choice == "g":
                return current
            if choice == "e":
                break
            if choice == "i":
                try:
                    entered = input("dtgen: instruction > ").strip()
                except EOFError:
                    sys.exit(0)
                if entered:
                    instruction = entered
                else:
                    print("dtgen: empty instruction, keeping the previous one",
                          file=sys.stderr)
                break
            if choice == "q":
                sys.exit(0)


def resolve_negative_prompt(args, params):
    if args.negative_prompt is not None:
        return args.negative_prompt
    if args.negative_prompt_file is not None:
        path = resolve_named_path(args.negative_prompt_file, PROMPTS_DIR, ".txt")
        return read_text_file(path, "negative prompt file")
    return params.get("negative_prompt")


def resolve_output(args, params, seed):
    ext = params.get("output_ext", "png").lstrip(".")
    target_dir = Path(args.output).expanduser() if args.output else Path.cwd()
    if target_dir.exists() and not target_dir.is_dir():
        die(f"output path exists and is not a directory: {target_dir}")
    target_dir.mkdir(parents=True, exist_ok=True)
    return target_dir / f"{int(time.time())}-{seed}.{ext}"


def append_backend_args(cmd, backend):
    if backend.get("cloud_compute"):
        cmd.append("--cloud-compute")
    if backend.get("remote"):
        cmd.append("--remote")
    if "remote_tls" in backend:
        cmd.append("--remote-tls" if backend["remote_tls"] else "--no-remote-tls")
    for key, flag in BACKEND_STRING_FLAGS.items():
        if key in backend:
            cmd += [flag, str(backend[key])]


def append_option_args(cmd, options):
    if "download_missing" in options:
        cmd.append("--download-missing" if options["download_missing"]
                   else "--no-download-missing")
    if options.get("disable_preview"):
        cmd.append("--disable-preview")
    if options.get("offline"):
        cmd.append("--offline")


def xml_escape(text):
    return (text.replace("&", "&amp;").replace("<", "&lt;")
            .replace(">", "&gt;").replace("\n", "&#xA;"))


def png_chunk(chunk_type, payload):
    return (struct.pack(">I", len(payload)) + chunk_type + payload
            + struct.pack(">I", zlib.crc32(chunk_type + payload)))


def exif_payload(width, height):
    """Minimal TIFF blob for a PNG eXIf chunk: an IFD0 whose single entry
    points to an Exif IFD carrying PixelXDimension / PixelYDimension,
    byte-identical in layout to what the Draw Things UI writes"""
    return (b"MM\x00*\x00\x00\x00\x08"
            + b"\x00\x01"
            + b"\x87\x69\x00\x04\x00\x00\x00\x01\x00\x00\x00\x1a"
            + b"\x00\x00\x00\x00"
            + b"\x00\x02"
            + b"\xa0\x02\x00\x04\x00\x00\x00\x01" + struct.pack(">I", width)
            + b"\xa0\x03\x00\x04\x00\x00\x00\x01" + struct.pack(">I", height)
            + b"\x00\x00\x00\x00")


def build_xmp(prompt, negative_prompt, model, seed, width, height, params):
    config = params.get("config", {})
    steps = params.get("steps")
    cfg = params.get("cfg")
    strength = params.get("strength")
    shift = config.get("shift")
    sampler_name = SAMPLER_NAMES.get(config.get("sampler"))
    seed_mode_name = SEED_MODE_NAMES.get(config.get("seedMode"))
    loras = config.get("loras", [])

    summary = []
    if steps is not None:
        summary.append(f"Steps: {steps}")
    if sampler_name:
        summary.append(f"Sampler: {sampler_name}")
    if cfg is not None:
        summary.append(f"Guidance Scale: {float(cfg)}")
    summary.append(f"Seed: {seed}")
    summary.append(f"Size: {width}x{height}")
    summary.append(f"Model: {model}")
    if strength is not None:
        summary.append(f"Strength: {float(strength)}")
    if seed_mode_name:
        summary.append(f"Seed Mode: {seed_mode_name}")
    if shift is not None:
        summary.append(f"Shift: {float(shift)}")
    for lora in loras:
        summary.append(f"LoRA Model: {lora.get('file', '')}")
        summary.append(f"LoRA Weight: {float(lora.get('weight', 1))}")
    description = prompt
    if negative_prompt:
        description += f"\n-{negative_prompt}"
    description += "\n" + ", ".join(summary)

    v2 = dict(config)
    v2.update({"model": model, "seed": seed, "width": width, "height": height})
    if steps is not None:
        v2["steps"] = steps
    if cfg is not None:
        v2["guidanceScale"] = cfg
    if strength is not None:
        v2["strength"] = strength
    if "frames" in params:
        v2["numFrames"] = params["frames"]

    comment = {"c": prompt, "uc": negative_prompt or "", "model": model,
               "seed": seed, "size": f"{width}x{height}", "v2": v2}
    if steps is not None:
        comment["steps"] = steps
    if cfg is not None:
        comment["scale"] = cfg
    if strength is not None:
        comment["strength"] = strength
    if sampler_name:
        comment["sampler"] = sampler_name
    if seed_mode_name:
        comment["seed_mode"] = seed_mode_name
    if shift is not None:
        comment["shift"] = shift
    if "maskBlur" in config:
        comment["mask_blur"] = config["maskBlur"]
    if loras:
        comment["lora"] = [{"model": l.get("file", ""),
                            "weight": l.get("weight", 1)} for l in loras]
    user_comment = json.dumps(comment, ensure_ascii=False, sort_keys=True,
                              separators=(",", ":"))

    return XMP_TEMPLATE.format(description=xml_escape(description),
                               user_comment=xml_escape(user_comment))


def embed_png_metadata(output, prompt, negative_prompt, model, seed, params):
    data = output.read_bytes()
    if not data.startswith(PNG_SIGNATURE) or data[12:16] != b"IHDR":
        print("dtgen: warning: output is not a PNG, metadata not embedded",
              file=sys.stderr)
        return
    width, height = struct.unpack(">II", data[16:24])
    pos = 8
    insert_at = None
    while pos + 8 <= len(data):
        length, = struct.unpack(">I", data[pos:pos + 4])
        if data[pos + 4:pos + 8] == b"IDAT":
            insert_at = pos
            break
        pos += 12 + length
    if insert_at is None:
        print("dtgen: warning: no IDAT chunk found, metadata not embedded",
              file=sys.stderr)
        return
    xmp = build_xmp(prompt, negative_prompt, model, seed, width, height, params)
    itxt = b"XML:com.adobe.xmp\x00\x00\x00\x00\x00" + xmp.encode("utf-8")
    inserted = (png_chunk(b"eXIf", exif_payload(width, height))
                + png_chunk(b"iTXt", itxt))
    output.write_bytes(data[:insert_at] + inserted + data[insert_at:])


def main():
    argv = sys.argv[1:]
    passthrough = []
    if "--" in argv:
        split = argv.index("--")
        argv, passthrough = argv[:split], argv[split + 1:]

    parser = argparse.ArgumentParser(
        prog="dtgen",
        description="Wrapper for draw-things-cli generate: "
                    "generation parameters live in TOML files, "
                    "prompt and output path come from the command line. "
                    "Arguments after \"--\" are passed through to "
                    "draw-things-cli generate verbatim",
    )
    parser.add_argument("--parameter-file", "-P", metavar="<file>",
                        help="parameter file: a name (subdirectories allowed) resolved "
                             "under parameters/, appending .toml when the last segment "
                             "has no extension; values starting with \"/\", \"~\", "
                             "\"./\" or \"../\" are treated as plain paths; "
                             "when omitted, the model's recommended settings are used")
    parser.add_argument("--prompt", "-p", help="prompt text")
    parser.add_argument("--prompt-file", "-f", metavar="<file>",
                        help="prompt file: a name resolved under prompts/ "
                             "(default extension .txt), same resolution rules as "
                             "--parameter-file; when neither this nor --prompt is "
                             "given, falls back to the parameter file's prompt, "
                             "then prompts/default.txt")
    parser.add_argument("--negative-prompt", "-n", help="negative prompt text")
    parser.add_argument("--negative-prompt-file", "-N", metavar="<file>",
                        help="negative prompt file, same resolution rules as "
                             "--prompt-file")
    parser.add_argument("--enhance", "-e", nargs="?", const=DEFAULT_ENHANCE_PRESET,
                        metavar="<preset>",
                        help="enhance the prompt with a local ollama model before "
                             "generation; the optional value names an enhancer "
                             "preset resolved under enhancers/ (default: "
                             f"{DEFAULT_ENHANCE_PRESET}), same resolution rules "
                             "as --prompt-file")
    parser.add_argument("--enhance-instruction", "-E", metavar="<text>",
                        help="ad-hoc enhancement instruction; combined with "
                             "--enhance it is appended to the preset, alone it "
                             "implies enhancement in custom-instruction mode")
    parser.add_argument("--enhance-language", "-L", choices=["en", "zh"],
                        metavar="<lang>",
                        help="output language of the enhanced prompt: en or zh "
                             "(Simplified Chinese); overrides the parameter "
                             "file's [enhancer] language, default en; presets "
                             "marked fixed-language ignore it")
    parser.add_argument("--enhance-once", action="store_true",
                        help="skip the interactive loop: enhance once and "
                             "proceed straight to generation")
    parser.add_argument("--enhance-only", action="store_true",
                        help="print the enhanced prompt to stdout and exit "
                             "without generating")
    parser.add_argument("--image", "-i", metavar="<path>",
                        help="input image for img2img "
                             "(absolute or relative to the current directory)")
    parser.add_argument("--model", "-m",
                        help="model (overrides the parameter file; required when "
                             "no parameter file is used)")
    parser.add_argument("--seed", "-s", type=int,
                        help="random seed (overrides the parameter file; "
                             "randomly generated when neither specifies one)")
    parser.add_argument("--output", "-o", metavar="<dir>",
                        help="output directory (absolute or relative to the current "
                             "directory; created recursively when missing; the file "
                             "is always auto-named \"<unix timestamp>-<seed>.<ext>\"; "
                             "when omitted, output goes to the current directory)")
    parser.add_argument("--dry-run", action="store_true",
                        help="print the full command that would run, "
                             "without executing it")
    args = parser.parse_args(argv)

    params = load_parameters(args.parameter_file) if args.parameter_file else {}

    if args.prompt is not None and args.prompt_file is not None:
        die("--prompt and --prompt-file are mutually exclusive")
    prompt_text = resolve_prompt_text(args, params)

    if (args.enhance_only or args.enhance_once) and args.enhance is None \
            and args.enhance_instruction is None:
        args.enhance = DEFAULT_ENHANCE_PRESET
    if args.enhance is not None or args.enhance_instruction is not None:
        prompt_text = enhance_prompt(prompt_text, args, params)
        if args.enhance_only:
            print(prompt_text)
            return
    prompt = apply_prompt_affixes(prompt_text, params)

    model = args.model or params.get("model")
    if not model:
        die("no model specified: set model in the parameter file or pass --model")

    negative_prompt = resolve_negative_prompt(args, params)

    if args.seed is not None:
        seed = args.seed
    elif "seed" in params:
        seed = int(params["seed"])
    else:
        seed = random.SystemRandom().randrange(2 ** 32)

    output = resolve_output(args, params, seed)

    cmd = ["draw-things-cli", "generate", "--model", str(model), "--prompt", prompt]
    if negative_prompt:
        cmd += ["--negative-prompt", negative_prompt]
    if args.image:
        cmd += ["--image", str(Path(args.image).expanduser())]
    for key, flag in SAMPLING_FLAGS.items():
        if key in params:
            cmd += [flag, str(params[key])]
    cmd += ["--seed", str(seed)]
    config = params.get("config", {})
    if config:
        cmd += ["--config-json", json.dumps(config, ensure_ascii=False)]
    append_backend_args(cmd, params.get("backend", {}))
    append_option_args(cmd, params.get("options", {}))
    cmd += ["--output", str(output)]
    cmd += passthrough

    if args.dry_run:
        print(shlex.join(cmd))
        return
    print(f"dtgen: writing output to {output}", file=sys.stderr)
    sys.stderr.flush()
    try:
        result = subprocess.run(cmd)
    except FileNotFoundError:
        die(f"command not found: {cmd[0]}")
    if result.returncode != 0:
        sys.exit(result.returncode)
    if not params.get("embed_metadata", True) or output.suffix.lower() != ".png":
        return
    if not output.is_file():
        print(f"dtgen: warning: expected output not found, "
              f"metadata not embedded: {output}", file=sys.stderr)
        return
    try:
        embed_png_metadata(output, prompt, negative_prompt, model, seed, params)
    except OSError as e:
        print(f"dtgen: warning: failed to embed metadata: {e}", file=sys.stderr)


if __name__ == "__main__":
    main()
